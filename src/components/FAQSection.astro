---
import { FAQS } from '../data/faqs';
---

<section class="hud-card rounded-2xl p-6 sm:p-8 border border-abyss-border space-y-6" id="faq">
  <div class="space-y-2 border-b border-abyss-border/60 pb-4">
    <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-abyss-cyan/15 border border-abyss-cyan/30 text-abyss-cyan text-xs font-mono font-bold">
      <span>Intel Briefing & FAQs</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight font-mono">
      Frequently Asked Questions
    </h2>
    <p class="text-xs sm:text-sm text-abyss-muted">
      Everything you need to know about Steam release timing, co-op mechanics, console ports, and secrets in End of Abyss.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    {FAQS.map((f) => (
      <div class="p-5 rounded-xl bg-abyss-void/80 border border-abyss-border space-y-2">
        <h3 class="text-sm font-bold text-white flex items-start gap-2">
          <span class="text-abyss-cyan font-mono">Q:</span>
          <span>{f.q}</span>
        </h3>
        <p class="text-xs text-abyss-muted leading-relaxed pl-5">
          {f.a}
        </p>
      </div>
    ))}
  </div>
</section>
