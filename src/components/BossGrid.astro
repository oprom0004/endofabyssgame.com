---
import { BOSS_ROSTER } from '../data/gameInfo';
---

<section class="space-y-6" id="bosses">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-abyss-border pb-4">
    <div>
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded bg-abyss-crimson/15 border border-abyss-crimson/30 text-abyss-crimson text-xs font-mono font-bold uppercase mb-2">
        <span>⚠️</span>
        <span>Bio-Mechanical Anomalies</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-black text-white font-mono tracking-tight">
        Major Boss Encounters & Vulnerabilities
      </h2>
      <p class="text-xs sm:text-sm text-abyss-muted">
        Tactical breakdown of the most dangerous apex entities roaming the subterranean research sectors.
      </p>
    </div>
    <a href="/walkthrough/#bosses" class="text-xs font-mono font-bold text-abyss-cyan hover:underline flex items-center gap-1 self-start sm:self-auto">
      <span>Full Strategy Guide</span>
      <span>→</span>
    </a>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    {BOSS_ROSTER.map((boss) => (
      <div class="hud-card hud-card-hover rounded-xl p-6 border border-abyss-border space-y-4">
        <div class="flex items-center justify-between">
          <span class="text-xs font-mono px-2 py-0.5 rounded bg-red-950/60 border border-red-800 text-red-400 font-bold">
            {boss.dangerLevel}
          </span>
          <span class="text-[11px] font-mono text-abyss-muted">Sector Data</span>
        </div>

        <div>
          <h3 class="text-lg font-bold text-white font-mono">{boss.name}</h3>
          <p class="text-xs text-abyss-cyan font-mono mt-0.5">{boss.location}</p>
        </div>

        <p class="text-xs text-abyss-muted leading-relaxed">
          {boss.description}
        </p>

        <div class="space-y-2 pt-3 border-t border-abyss-border/60 text-xs font-mono">
          <div class="flex items-start gap-1">
            <span class="text-abyss-hazard font-bold shrink-0">Weak Point:</span>
            <span class="text-slate-300">{boss.weakness}</span>
          </div>
          <div class="flex items-start gap-1">
            <span class="text-abyss-emerald font-bold shrink-0">Recommended:</span>
            <span class="text-slate-300">{boss.recommendedWeapon}</span>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
